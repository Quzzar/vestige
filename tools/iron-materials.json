  "quality_policy": {
    "quality_source": "pattern_designated_part_material",
    "default_source_quality": 1,
    "effective_quality": "source_quality * pattern_multiplier * bonus_multiplier",
    "attribute_amount": "base_amount * effective_quality",
    "scalar_amount": "base + (effective_quality - 1) * slope",
    "scalar_clamping": "positive-base values are bounded upward by minimum_magnitude and downward by maximum_magnitude; negative-base values reverse these comparisons",
    "missing_parameter": "no bonus for that parameter",
    "parameter_override": "an explicit pattern bonus parameter replaces material selection for that bonus",
